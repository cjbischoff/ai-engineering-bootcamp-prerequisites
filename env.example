# AI Engineering Bootcamp - Environment Variables Template
#
# SETUP OPTIONS:
#
# Option 1: 1Password Secret References (Recommended)
# ===================================================
# This project uses 1Password for secure secret management.
# The .env file contains references like: op://Personal/api_openai/credential
#
# To use 1Password injection:
#   1. Ensure 1Password CLI is installed: brew install --cask 1password-cli
#   2. Authenticate: op signin
#   3. Run commands with: op run --env-file=".env" -- <command>
#
# Examples:
#   op run --env-file=".env" -- make run-docker-compose
#   op run --env-file=".env" -- make health
#   op run --env-file=".env" -- make smoke-test
#
# Docker Compose: `env_file: .env` alone passes literal `op://` strings into containers.
# This repo’s docker-compose.yml also sets `environment: ${OPENAI_API_KEY}` (etc.) so Compose
# substitutes from the host environment first. `make run-docker-compose` uses `op` when the
# CLI is installed, so secrets are resolved before `docker compose` runs.
#
# Option 2: Manual API Keys (Not Recommended)
# ===========================================
# If you don't want to use 1Password, copy this file to .env and add your API keys:
#   cp env.example .env
#   # Then edit .env with your actual API keys
#
# ⚠️  WARNING: Never commit .env file with actual API keys to Git!

# OpenAI API (for embeddings and LLM)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google GenAI API (alternative LLM provider)
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# Groq API (fast inference provider)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# LangSmith Configuration (observability and tracing)
# Get from: https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-tracing

# Cohere API (for reranking)
# Get from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# HuggingFace Token (for model downloads)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=
